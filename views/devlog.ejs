<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body class="devlog-body">

    <%- include('partials/navbar') %>

    <main class="devlog-container">
        <header class="devlog-header">
            <span class="devlog-kicker">urBackend / Engineering Log</span>
            <h1 class="page-title">Architecture Notes</h1>
            <p class="page-description">
                Deep dives into query profiling, caching strategies, connection pooling, and latency benchmarks from urBackend.
            </p>
            <span class="devlog-last-updated">Last updated — Jan 28, 2026</span>
        </header>

        <section class="devlog-article-stream">
            <% entries.forEach((entry, index) => { %>
                <article class="devlog-post">
                    <div class="devlog-meta">
                        <time class="entry-date"><%= entry.date %></time>
                    </div>

                    <h2 class="devlog-post-title"><%= entry.title %></h2>

                    <div class="devlog-content-block">
                        <div class="devlog-sub-section">
                            <h3>Context</h3>
                            <p><%= entry.context %></p>
                        </div>

                        <div class="devlog-sub-section">
                            <h3>Problem</h3>
                            <p><%= entry.problem %></p>
                        </div>

                        <div class="devlog-sub-section">
                            <h3>Analysis</h3>
                            <p><%= entry.analysis %></p>
                        </div>

                        <div class="devlog-sub-section">
                            <h3>Solution Code</h3>
                            <div class="code-block">
                                <pre><code><%= entry.solution %></code></pre>
                            </div>
                        </div>

                        <div class="devlog-sub-section">
                            <h3>Why This Works</h3>
                            <p><%= entry.whyWorks %></p>
                        </div>

                        <div class="devlog-sub-section">
                            <h3>Measured Result</h3>
                            <p class="result-text"><%= entry.result %></p>
                        </div>

                        <div class="devlog-sub-section takeaway-box">
                            <h3>Key Takeaway</h3>
                            <p class="takeaway-text"><%= entry.keyLearning %></p>
                        </div>
                    </div>
                </article>

                <% if (index < entries.length - 1) { %>
                    <hr class="devlog-post-divider">
                <% } %>
            <% }) %>
        </section>
    </main>

    <%- include('partials/command-palette') %>
    <%- include('partials/footer') %>

    <script src="/js/command.js"></script>
    <script defer src="https://cdn.vercel-insights.com/v1/script.js"></script>
</body>
</html>
