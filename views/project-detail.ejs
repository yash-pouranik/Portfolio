<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body class="page-project-detail">

    <%- include('partials/navbar') %>

    <main class="main-content">

        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/projects">← Projects</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current"><%= project.title %></span>
        </nav>

        <article class="detail-article">

            <!-- ── Header ─────────────────────────────────────────── -->
            <header class="detail-header">
                <div class="detail-meta-row">
                    <span class="detail-category"><%= project.category %></span>
                    <span class="detail-year"><%= project.year %></span>
                    <% if (project.badge) { %>
                        <span class="detail-badge"><%= project.badge %></span>
                    <% } %>
                </div>

                <h1 class="detail-title"><%= project.title %></h1>
                <p class="detail-tagline"><%= project.tagline %></p>

                <!-- Link row -->
                <div class="detail-links">
                    <% if (project.live && project.live !== '#' && project.live !== '/') { %>
                        <a href="<%= project.live %>" target="_blank" rel="noopener noreferrer" class="detail-link detail-link--primary">Live ↗</a>
                    <% } %>
                    <% if (project.docs) { %>
                        <a href="<%= project.docs %>" target="_blank" rel="noopener noreferrer" class="detail-link">Docs ↗</a>
                    <% } %>
                    <% if (project.npm) { %>
                        <a href="<%= project.npm %>" target="_blank" rel="noopener noreferrer" class="detail-link">npm ↗</a>
                    <% } %>
                    <% if (project.npm_cli) { %>
                        <a href="<%= project.npm_cli %>" target="_blank" rel="noopener noreferrer" class="detail-link">CLI on npm ↗</a>
                    <% } %>
                    <% if (project.npm_sdk) { %>
                        <a href="<%= project.npm_sdk %>" target="_blank" rel="noopener noreferrer" class="detail-link">SDK on npm ↗</a>
                    <% } %>
                    <% if (project.article) { %>
                        <a href="<%= project.article %>" target="_blank" rel="noopener noreferrer" class="detail-link">Article ↗</a>
                    <% } %>
                    <% if (project.repo) { %>
                        <a href="<%= project.repo %>" target="_blank" rel="noopener noreferrer" class="detail-link">GitHub ↗</a>
                    <% } %>
                </div>
            </header>

            <hr class="detail-rule">

            <!-- ── Body ───────────────────────────────────────────── -->
            <div class="detail-body">

                <!-- Overview -->
                <section class="detail-section">
                    <h2 class="detail-section-label">Overview</h2>
                    <p class="detail-prose"><%= project.desc %></p>
                </section>

                <!-- Key achievements -->
                <% if (project.highlights && project.highlights.length > 0) { %>
                    <section class="detail-section">
                        <h2 class="detail-section-label">Engineering Decisions</h2>
                        <ul class="detail-bullets">
                            <% project.highlights.forEach(h => { %>
                                <li><%= h %></li>
                            <% }) %>
                        </ul>
                    </section>
                <% } %>

                <!-- Stack -->
                <section class="detail-section">
                    <h2 class="detail-section-label">Stack</h2>
                    <% if (project.stack && project.stack.length > 0) { %>
                        <div class="detail-stack-tags">
                            <% project.stack.forEach(t => { %>
                                <span class="detail-stack-tag"><%= t %></span>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="detail-prose"><%= project.stats %></p>
                    <% } %>
                </section>

            </div>

            <!-- ── Footer ─────────────────────────────────────────── -->
            <div class="detail-footer-nav">
                <a href="/projects" class="detail-back">← All Projects</a>
            </div>

        </article>
    </main>

    <%- include('partials/command-palette') %>
    <%- include('partials/footer') %>

    <script src="/js/command.js"></script>
    <script defer src="https://cdn.vercel-insights.com/v1/script.js"></script>
</body>
</html>