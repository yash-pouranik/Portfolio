<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body class="page-projects">

    <%- include('partials/navbar') %>

    <main class="main-content">
        <header class="project-page-header">
            <h1 class="page-title">Projects</h1>
            <p class="page-description">
                A collection of open-source BaaS infrastructure, AI debugging CLI tools, npm SDK packages, and production systems.
            </p>

            <!-- Interactive Filter & Search Bar -->
            <div class="project-controls">
                <div class="filter-pills" id="filter-pills">
                    <button class="filter-pill active" data-filter="all">All (8)</button>
                    <button class="filter-pill" data-filter="infrastructure">Infrastructure &amp; BaaS</button>
                    <button class="filter-pill" data-filter="devtools">DevTools &amp; CLIs</button>
                    <button class="filter-pill" data-filter="production">Production Apps</button>
                </div>
                <div class="project-search-wrap">
                    <input type="text" id="project-search" placeholder="Filter by tech (e.g. Redis, LLM, Socket.IO)..." autocomplete="off" spellcheck="false">
                </div>
            </div>
        </header>

        <!-- Projects Grid -->
        <section class="project-list-section">
            <div class="project-grid" id="project-grid">
                <% projects.forEach(project => { 
                    let catSlug = "production";
                    if (project.category.includes('Infrastructure') || project.category.includes('Open Source')) {
                        catSlug = "infrastructure";
                    } else if (project.category.includes('Tooling') || project.category.includes('SDK') || project.category.includes('AI')) {
                        catSlug = "devtools";
                    }
                %>
                    <article class="project-card standalone" 
                             data-category="<%= catSlug %>" 
                             data-search="<%= (project.title + ' ' + project.tagline + ' ' + (project.stack || []).join(' ') + ' ' + project.stats).toLowerCase() %>">
                        
                        <div class="project-card-top">
                            <div class="project-card-meta-row">
                                <span class="project-card-category"><%= project.category %></span>
                                <span class="project-card-year"><%= project.year %></span>
                            </div>
                            <% if (project.badge) { %>
                                <span class="project-card-badge"><%= project.badge %></span>
                            <% } %>
                        </div>

                        <h2 class="project-card-title"><%= project.title %></h2>
                        <p class="project-card-tagline"><%= project.tagline %></p>

                        <% if (project.bullets && project.bullets.length > 0) { %>
                            <ul class="project-bullets">
                                <% project.bullets.forEach(b => { %>
                                    <li><%= b %></li>
                                <% }) %>
                            </ul>
                        <% } %>

                        <% if (project.stack && project.stack.length > 0) { %>
                            <div class="project-stack-tags">
                                <% project.stack.forEach(t => { %>
                                    <span class="stack-tag"><%= t %></span>
                                <% }) %>
                            </div>
                        <% } %>

                        <div class="project-card-actions">
                            <a href="/projects/<%= project.slug %>" class="btn-detail">Details →</a>
                            <div class="project-secondary-links">
                                <% if (project.live) { %>
                                    <a href="<%= project.live %>" target="_blank" rel="noopener noreferrer">Live ↗</a>
                                <% } %>
                                <% if (project.docs) { %>
                                    <a href="<%= project.docs %>" target="_blank" rel="noopener noreferrer">Docs ↗</a>
                                <% } %>
                                <% if (project.npm || project.npm_cli) { %>
                                    <a href="<%= project.npm || project.npm_cli %>" target="_blank" rel="noopener noreferrer">npm ↗</a>
                                <% } %>
                                <% if (project.repo) { %>
                                    <a href="<%= project.repo %>" target="_blank" rel="noopener noreferrer">Source ↗</a>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>

            <div class="no-projects-found" id="no-projects" style="display: none;">
                <p>No projects match your current search/filter.</p>
                <button class="email-btn" id="reset-filter-btn" style="margin-top: 10px;">Reset Filters</button>
            </div>
        </section>
    </main>

    <%- include('partials/command-palette') %>
    <%- include('partials/footer') %>

    <script src="/js/command.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const pills = document.querySelectorAll(".filter-pill");
            const searchInput = document.getElementById("project-search");
            const cards = document.querySelectorAll(".project-card");
            const noProjects = document.getElementById("no-projects");
            const resetBtn = document.getElementById("reset-filter-btn");

            let currentCategory = "all";
            let searchQuery = "";

            function applyFilters() {
                let visibleCount = 0;
                cards.forEach(card => {
                    const cardCat = card.dataset.category;
                    const cardSearch = card.dataset.search;

                    const matchCategory = (currentCategory === "all") || (cardCat === currentCategory);
                    const matchSearch = !searchQuery || cardSearch.includes(searchQuery);

                    if (matchCategory && matchSearch) {
                        card.style.display = "block";
                        visibleCount++;
                    } else {
                        card.style.display = "none";
                    }
                });

                if (visibleCount === 0) {
                    noProjects.style.display = "block";
                } else {
                    noProjects.style.display = "none";
                }
            }

            pills.forEach(pill => {
                pill.addEventListener("click", () => {
                    pills.forEach(p => p.classList.remove("active"));
                    pill.classList.add("active");
                    currentCategory = pill.dataset.filter;
                    applyFilters();
                });
            });

            searchInput.addEventListener("input", (e) => {
                searchQuery = e.target.value.toLowerCase().trim();
                applyFilters();
            });

            if (resetBtn) {
                resetBtn.addEventListener("click", () => {
                    currentCategory = "all";
                    searchQuery = "";
                    searchInput.value = "";
                    pills.forEach(p => p.classList.remove("active"));
                    pills[0].classList.add("active");
                    applyFilters();
                });
            }
        });
    </script>
    <script defer src="https://cdn.vercel-insights.com/v1/script.js"></script>
</body>
</html>