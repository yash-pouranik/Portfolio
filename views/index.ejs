<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>

    <%- include('partials/navbar') %>

    <main class="main-index">
        <!-- Zeno Rocha Style Hero -->
        <header class="index-header">
            <h1>Yash Pouranik</h1>
            <p class="hero-bio">
                <strong>Backend Engineer &amp; Maintainer at <a href="https://github.com/yash-pouranik/urBackend" target="_blank" rel="noopener noreferrer">urBackend</a></strong><br>
                Obsessed with developer experience &amp; high-performance backend systems.
            </p>

            <div class="hero-meta">
                <span>Press <kbd>Ctrl</kbd> <kbd>K</kbd> to launch palette</span>
                <span class="meta-separator">·</span>
                <a href="https://docs.google.com/document/d/1rK6SaLtP3orhxonM8mJkxzjCMNdicj2lJK_Yn3N8v-g/edit?usp=sharing" target="_blank" rel="noopener noreferrer" class="hero-resume-link">View Resume ↗</a>
                <span class="meta-separator">·</span>
                <span class="visitor-badge">
                    <span class="visitor-dot"></span>
                    Visitor #<strong><%= visitNumber %></strong>
                </span>
            </div>
        </header>

        <!-- Metrics Strip -->
        <section class="proof-bar-section">
            <div class="proof-grid">
                <div class="proof-card">
                    <div class="proof-number">800+</div>
                    <div class="proof-label">Active Users</div>
                </div>
                <div class="proof-card">
                    <div class="proof-number">8k+</div>
                    <div class="proof-label">PDF Downloads <a href="https://campusnotes.bitbros.in/">@CampusNotes</a></div>
                </div>
                <div class="proof-card">
                    <div class="proof-number">70%</div>
                    <div class="proof-label">Auth Speedup</div>
                </div>
                <div class="proof-card">
                    <div class="proof-number">40+</div>
                    <div class="proof-label">OS Contributors</div>
                </div>
                <div class="proof-card">
                    <div class="proof-number">4</div>
                    <div class="proof-label">npm Packages</div>
                </div>
            </div>
        </section>

        <!-- Featured Projects -->
        <section class="home-section">
            <div class="section-header-flex">
                <span class="section-title">Selected Work</span>
                <a href="/projects" class="view-all-link">View all projects →</a>
            </div>
            
            <div class="project-grid">
                <% featuredProjects.forEach(project => { %>
                    <a href="/projects/<%= project.slug %>" class="project-card">
                        <div class="project-card-header">
                            <span class="project-card-category"><%= project.category %></span>
                            <span><%= project.year %></span>
                        </div>
                        <div class="project-card-title"><%= project.title %></div>
                        <div class="project-card-tagline"><%= project.tagline %></div>
                        
                        <% if (project.bullets && project.bullets.length > 0) { %>
                            <ul class="project-bullets-sm">
                                <% project.bullets.slice(0, 2).forEach(b => { %>
                                    <li><%= b %></li>
                                <% }) %>
                            </ul>
                        <% } %>

                        <div class="project-card-footer">
                            <% if (project.stack && project.stack.length > 0) { %>
                                <div class="project-stack-tags-sm">
                                    <% project.stack.slice(0, 3).forEach(t => { %>
                                        <span class="stack-tag-sm"><%= t %></span>
                                    <% }) %>
                                </div>
                            <% } %>
                            <span class="card-arrow">→</span>
                        </div>
                    </a>
                <% }) %>
            </div>
        </section>

        <!-- Articles -->
        <section class="home-section">
            <div class="section-header-flex">
                <span class="section-title">Writing</span>
                <a href="/articles" class="view-all-link">Read all articles →</a>
            </div>

            <div class="article-grid">
                <% featuredArticles.forEach(article => { %>
                    <a href="<%= article.url %>" class="article-card" target="_blank" rel="noopener noreferrer">
                        <div class="article-meta">
                            <span><%= article.date %></span>
                            <span><%= article.readTime %></span>
                        </div>
                        <div class="article-card-title"><%= article.title %></div>
                        <div class="article-card-description"><%= article.description %></div>
                        <div class="article-card-link">Read on Medium ↗</div>
                    </a>
                <% }) %>
            </div>
        </section>

        <!-- Focus Areas -->
        <section class="home-section">
            <span class="section-title">Focus</span>
            <div class="services-grid">
                <div class="service-item">
                    <h4>01. Backend &amp; API Infrastructure</h4>
                    <p>High-throughput REST APIs, Redis caching layers, MongoDB query optimization, and AES-256-GCM connection pooling.</p>
                </div>
                <div class="service-item">
                    <h4>02. Auth &amp; Security Engineering</h4>
                    <p>JWT &amp; session auth, rate limiting, row-level access control, and atomic DB updates ($inc, $push).</p>
                </div>
                <div class="service-item">
                    <h4>03. Developer Tooling &amp; SDKs</h4>
                    <p>CLI utilities (Errlocal) and npm SDK packages (@kiroo/sdk) for stack trace parsing and deterministic API interaction replays.</p>
                </div>
            </div>
        </section>

        <!-- Timeline -->
        <section class="home-section">
            <span class="section-title">Timeline</span>
            <div class="achievements-list">
                <div class="achievement-item">
                    <div class="achievement-year">2026</div>
                    <div class="achievement-content">
                        <h4>Odoo Offline Hackathon 2026 — Selected</h4>
                        <p>Selected among <strong>2,500 students out of 20,000+ applicants</strong> nationwide for the Odoo offline hackathon.</p>
                    </div>
                </div>

                <div class="achievement-item">
                    <div class="achievement-year">2026</div>
                    <div class="achievement-content">
                        <h4>GSSoC'2026 — Project Maintainer</h4>
                        <p>Selected to lead <a href="https://github.com/yash-pouranik/urBackend" target="_blank" rel="noopener noreferrer" class="link-accent">urBackend</a> as an official open-source project, managing 40+ PRs from 25+ global contributors.</p>
                    </div>
                </div>

                <div class="achievement-item">
                    <div class="achievement-year">2026</div>
                    <div class="achievement-content">
                        <h4>2nd Place — National Technical Writing (Kiroo)</h4>
                        <p>Authored a Medium article on API interaction replay systems for <a href="https://medium.com/@yashpouranik124/stop-guessing-api-bugs-how-i-built-git-for-api-interactions-14a29d3bb428" target="_blank" rel="noopener noreferrer" class="link-accent">Kiroo</a> and won 2nd place nationally.</p>
                    </div>
                </div>

                <div class="achievement-item">
                    <div class="achievement-year">2025 - July</div>
                    <div class="achievement-content">
                        <h4>MERN TA Intern — Apna College</h4>
                        <p>Mentored 200+ engineering learners in Full Stack Development &amp; Backend Architecture.</p>
                    </div>
                </div>

                <div class="achievement-item">
                    <div class="achievement-year">2025 - July</div>
                    <div class="achievement-content">
                        <h4>Solve for India Hackathon</h4>
                        <p>Built <strong>GullyBazar</strong> in 48 hours — ranked <strong>Top 25 / ~800 teams</strong> at the Tutedude national hackathon.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact CTA -->
        <section class="home-section">
            <span class="section-title">Contact</span>
            <p style="color: #a1a1aa; margin-bottom: 20px;">
                Currently open for backend engineering roles. Whether you have a project in mind or just want to chat, feel free to reach out.
            </p>
            <a href="mailto:yashpouranik124@gmail.com" class="email-btn">Say Hello</a>
            <a href="https://docs.google.com/document/d/1rK6SaLtP3orhxonM8mJkxzjCMNdicj2lJK_Yn3N8v-g/edit?usp=sharing" target="_blank" rel="noopener noreferrer" class="email-btn" style="margin-left: 12px;">View Resume</a>
        </section>
    </main>

    <%- include('partials/command-palette') %>
    <%- include('partials/footer') %>

    <script src="/js/command.js"></script>
    <script defer src="https://cdn.vercel-insights.com/v1/script.js"></script>
</body>
</html>
